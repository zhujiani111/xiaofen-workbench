/* pages/food/food.wxss */
.container{padding:16rpx 24rpx 120rpx}
.section-title{font-size:28rpx;font-weight:700;color:#E8557A;margin:24rpx 0 14rpx}
.card{background:#fff;border-radius:20rpx;padding:24rpx;border:2rpx solid #FFE4EC;margin-bottom:16rpx}
.card.center{text-align:center}
.photo-btn{background:#FFE4EC;color:#E8557A;border:none;border-radius:28rpx;font-size:24rpx;padding:14rpx 32rpx}
.photo-preview{width:100%;max-height:300rpx;border-radius:16rpx;margin-top:16rpx}
.photo-results{margin-top:16rpx}
.photo-hint{font-size:22rpx;color:#616161;display:block;margin-bottom:10rpx}
.food-options{display:flex;flex-wrap:wrap;gap:10rpx}
.food-opt{background:#FFE4EC;color:#E8557A;padding:12rpx 20rpx;border-radius:20rpx;font-size:20rpx}
.food-opt:active{background:#FFD1DC}

.meals{display:flex;gap:10rpx;margin-bottom:16rpx}
.meal{flex:1;background:#FFF0F5;border-radius:16rpx;padding:16rpx 6rpx;text-align:center;border:2rpx solid transparent}
.meal:active{border-color:#FFB6C9}
.meal-icon{font-size:36rpx;display:block}
.meal-name{font-size:20rpx;color:#616161;display:block;margin-top:4rpx}
.meal-kcal{font-size:18rpx;color:#FF6B8A;font-weight:600;display:block}
.meal-detail{font-size:16rpx;color:#9E9E9E;display:block;margin-top:4rpx}
.meal-empty{font-size:16rpx;color:#E0E0E0;display:block;margin-top:4rpx}

.nutri-row{display:flex;align-items:center;margin:10rpx 0;gap:10rpx}
.nutri-label{font-size:20rpx;color:#616161;width:80rpx}
.nutri-track{flex:1;height:12rpx;background:#EEE;border-radius:6rpx;overflow:hidden}
.nutri-fill{height:100%;border-radius:6rpx}
.nutri-val{font-size:18rpx;color:#9E9E9E;width:90rpx;text-align:right}
.kcal-total{text-align:center;margin-top:12rpx;font-size:24rpx;color:#616161}
.kcal-num{font-size:36rpx;font-weight:700;color:#FF6B8A}

.add-btn{background:#fff;color:#FF6B8A;border:2rpx solid #FFB6C9;border-radius:24rpx;font-size:24rpx;padding:10rpx;margin:8rpx 0}

.menu-card{background:#FFF0F5;border-radius:16rpx;padding:18rpx;margin-bottom:12rpx;border:2rpx dashed #FFB6C9}
.menu-card:active{background:#FFE4EC}
.menu-title{font-size:24rpx;color:#E8557A;font-weight:600;display:block}
.menu-kcal{font-size:20rpx;color:#9E9E9E;font-weight:400}
.menu-cat{font-size:18rpx;color:#9E9E9E;display:block;margin-top:4rpx}
.menu-rating{display:flex;gap:6rpx;margin-top:8rpx}
.star{font-size:28rpx;opacity:.3}
.star.active{opacity:1}
