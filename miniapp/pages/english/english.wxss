/* pages/english/english.wxss */
.container{padding:16rpx 24rpx 120rpx}
.section-title{font-size:28rpx;font-weight:700;color:#E8557A;margin:24rpx 0 14rpx}
.streak{text-align:center;margin-bottom:16rpx}
.sn{font-size:56rpx;font-weight:800;color:#FF6B8A;display:block}
.sl{font-size:22rpx;color:#9E9E9E;display:block}

.stats{display:flex;gap:10rpx}
.stat{flex:1;background:#fff;border-radius:16rpx;padding:16rpx 6rpx;text-align:center;border:2rpx solid #FFD1DC}
.sn2{font-size:28rpx;font-weight:700;color:#FF6B8A;display:block}
.sl2{font-size:16rpx;color:#9E9E9E;display:block}

.word-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10rpx}
.word-card{background:#fff;border-radius:12rpx;padding:14rpx 8rpx;text-align:center;border:2rpx solid #FFD1DC}
.word-card.mastered{opacity:.35;background:#FFF0F5}
.w{font-size:22rpx;font-weight:700;color:#E8557A;display:block}
.p{font-size:16rpx;color:#9E9E9E;display:block}
.m{font-size:18rpx;color:#616161;display:block;margin-top:4rpx}
.kb{margin-top:8rpx;padding:4rpx 14rpx;border-radius:14rpx;border:2rpx solid #FFB6C9;font-size:18rpx;color:#FF6B8A;display:inline-block}
.md{font-size:16rpx;color:#FF8DA8;display:block;margin-top:8rpx}

.scenario-card{background:#FFF0F5;border-radius:16rpx;padding:20rpx;border:2rpx dashed #FFB6C9;margin-bottom:16rpx}
.sc-title{font-size:24rpx;color:#E8557A;font-weight:600;display:block;margin-bottom:10rpx}
.sc-content{font-size:22rpx;color:#616161;display:block;line-height:1.5;white-space:pre-line}
.sc-tip{font-size:18rpx;color:#FF8DA8;display:block;margin-top:10rpx}

.done-btn{background:#FF6B8A;color:#fff;border:none;border-radius:24rpx;font-size:24rpx;padding:14rpx;width:100%;margin-top:16rpx}
