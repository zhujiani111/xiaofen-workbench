/* pages/diary/diary.wxss */
.container{padding:16rpx 24rpx 120rpx}
.section-title{font-size:28rpx;font-weight:700;color:#E8557A;margin:24rpx 0 14rpx}
.guide{background:linear-gradient(135deg,#FFF0F5,#fff);border-radius:16rpx;padding:24rpx;margin-bottom:16rpx}
.step{text-align:center}
.sq{font-size:26rpx;color:#E8557A;font-weight:600;display:block;margin-bottom:12rpx}
.si{width:100%;border:2rpx solid #FFD1DC;border-radius:16rpx;padding:14rpx;font-size:24rpx;margin:8rpx 0}
.sb{background:#FF8DA8;color:#fff;border:none;border-radius:24rpx;font-size:22rpx;padding:10rpx 32rpx;margin-top:8rpx}
.done-step{color:#FF6B8A}
.sh{font-size:20rpx;color:#9E9E9E;display:block;margin-top:8rpx}

.photo-btn{background:#FFE4EC;color:#E8557A;border:none;border-radius:24rpx;font-size:24rpx;padding:12rpx 24rpx;margin-bottom:12rpx}
.photo{width:100%;max-height:300rpx;border-radius:16rpx;margin-bottom:12rpx}
.diary-input{width:100%;min-height:160rpx;padding:16rpx;border:2rpx solid #FFD1DC;border-radius:16rpx;font-size:24rpx;box-sizing:border-box;line-height:1.6}
.moods{display:flex;gap:10rpx;margin:12rpx 0}
.mood{font-size:36rpx;opacity:.4}
.mood.active{opacity:1}
.save-btn{background:#FF6B8A;color:#fff;border:none;border-radius:24rpx;font-size:24rpx;padding:12rpx;width:100%;margin:8rpx 0}

.diary-item{background:#fff;border-radius:16rpx;padding:18rpx;margin:10rpx 0;border:2rpx solid #FFE4EC}
.di-row{display:flex;justify-content:space-between;align-items:center}
.di-date{font-size:20rpx;color:#9E9E9E}
.di-mood{font-size:28rpx}
.di-photo{width:100%;max-height:260rpx;border-radius:12rpx;margin:8rpx 0}
.di-text{font-size:22rpx;color:#212121;line-height:1.5;display:block}
