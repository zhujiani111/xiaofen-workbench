/* pages/reading/reading.wxss */
.container{padding:16rpx 24rpx 120rpx}
.section-title{font-size:28rpx;font-weight:700;color:#E8557A;margin:24rpx 0 14rpx}

.subtabs{display:flex;gap:10rpx;margin-bottom:20rpx}
.stab{padding:10rpx 24rpx;border-radius:24rpx;border:2rpx solid #FFD1DC;font-size:24rpx;color:#FF6B8A}
.stab.active{background:#FF6B8A;color:#fff;border-color:transparent}

.refresh-btn{background:#FFE4EC;color:#E8557A;border:none;border-radius:28rpx;font-size:24rpx;padding:10rpx 24rpx;margin-bottom:16rpx}

.book-card{display:flex;gap:14rpx;background:#FFF0F5;border-radius:16rpx;padding:16rpx;margin-bottom:12rpx;border:2rpx solid #FFE4EC}
.book-card:active{background:#FFE4EC}
.book-card.done{opacity:.7}
.bc-cover{width:72rpx;height:100rpx;background:linear-gradient(135deg,#FFB6C9,#FF6B8A);border-radius:10rpx;display:flex;align-items:center;justify-content:center;font-size:32rpx;flex-shrink:0}
.bc-info{flex:1}
.bc-title{font-size:24rpx;font-weight:700;color:#212121;display:block}
.bc-author{font-size:18rpx;color:#9E9E9E;display:block;margin:4rpx 0}
.bc-desc{font-size:18rpx;color:#616161;display:block;line-height:1.3}
.bc-action{font-size:18rpx;color:#FF6B8A;display:block;margin-top:6rpx}
.bc-progress-bar{height:8rpx;background:#EEE;border-radius:4rpx;overflow:hidden;margin:8rpx 0}
.bc-progress-fill{height:100%;background:#FF8DA8;border-radius:4rpx}
.bc-progress-label{font-size:18rpx;color:#9E9E9E;display:block}

.search-row{display:flex;gap:10rpx;margin-bottom:16rpx}
.search-input{flex:1;border:2rpx solid #FFD1DC;border-radius:20rpx;padding:14rpx 20rpx;font-size:24rpx}
.search-btn{background:#FF6B8A;color:#fff;border:none;border-radius:20rpx;padding:14rpx 28rpx;font-size:24rpx}
.search-item{display:flex;justify-content:space-between;align-items:center;padding:16rpx;border-bottom:2rpx solid #F5F5F5}
.si-title{font-size:24rpx;font-weight:600;display:block}
.si-author{font-size:18rpx;color:#9E9E9E;display:block;margin-top:4rpx}
.si-onshelf{font-size:18rpx;color:#FF8DA8}
.si-add{background:#fff;color:#FF6B8A;border:2rpx solid #FFB6C9;border-radius:16rpx;font-size:20rpx;padding:6rpx 18rpx}

.quote-card{background:linear-gradient(135deg,#FFF0F5,#fff);border-left:6rpx solid #FF8DA8;border-radius:12rpx;padding:18rpx;font-size:22rpx;line-height:1.5;color:#616161;font-style:italic}
.quote-src{text-align:right;font-size:18rpx;color:#9E9E9E;display:block;margin-top:6rpx;font-style:normal}

.note-input{width:100%;min-height:120rpx;padding:16rpx;border:2rpx solid #FFD1DC;border-radius:16rpx;font-size:24rpx;box-sizing:border-box}
.note-btn{background:#FF6B8A;color:#fff;border:none;border-radius:24rpx;font-size:24rpx;padding:10rpx 28rpx;margin:10rpx 0}
.note-item{padding:16rpx;background:#fff;border-radius:12rpx;margin:8rpx 0;border:2rpx solid #FFE4EC}
.ni-date{font-size:18rpx;color:#9E9E9E;display:block}
.ni-text{font-size:22rpx;color:#212121;display:block;margin-top:6rpx;line-height:1.5}

.empty{text-align:center;padding:30rpx;color:#9E9E9E;font-size:22rpx}
